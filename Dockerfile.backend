# Dockerfile for FastAPI Backend Service
FROM python:3.11-slim

# Set working directory to telegram_bot/backend
WORKDIR /app/telegram_bot/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY telegram_bot/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire telegram_bot directory so imports work correctly
COPY telegram_bot/ /app/telegram_bot/

# Copy migrations if needed
COPY migrations/ /app/migrations/

# Copy env files to app root
COPY .env* /app/

# Set Python path to include the monorepo root so all imports resolve
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI from the backend directory but with correct imports
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
