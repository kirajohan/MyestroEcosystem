# Dockerfile for FastAPI Backend Service
FROM python:3.11-slim

# Loyihaning asosiy ildiz (root) katalogini belgilaymiz
WORKDIR /app

# System dependencies o'rnatish (Xotirani tejaydigan variant)
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client curl && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 1. Requirements faylini to'g'ri manzilga ko'chirib, o'rnatamiz
COPY telegram_bot/backend/requirements.txt ./telegram_bot/backend/
RUN pip install --no-cache-dir -r telegram_bot/backend/requirements.txt

# 2. MUHIM: Xatolikni yo'qotish uchun butun 'shared' va 'telegram_bot' papkalarini ko'chiramiz
COPY shared/ ./shared/
COPY telegram_bot/ ./telegram_bot/

# 3. Agar kerak bo'lsa, migratsiya va env fayllarini nusxalaymiz
COPY migrations/ ./migrations/
COPY .env* ./

# Python barcha modullarni (ham 'telegram_bot', ham 'shared'ni) topishi uchun PYTHONPATH sozlaymiz
ENV PYTHONPATH=/app:/app/telegram_bot/backend

# Health check (Portni Railway o'zi beradigan $PORT o'zgaruvchisiga moslaymiz)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Backend papkasining ichiga kirib uvicorn-ni ishga tushiramiz
WORKDIR /app/telegram_bot/backend
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
