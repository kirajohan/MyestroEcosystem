FROM python:3.11-slim

WORKDIR /app

# 1. Backend ichidagi talablar faylini ko'chiramiz va o'rnatamiz
COPY telegram_bot/backend/requirements.txt ./telegram_bot/backend/
RUN pip install --no-cache-dir -r telegram_bot/backend/requirements.txt

# 2. Butun backend kodini konteynerga nusxalaymiz
COPY telegram_bot/backend/ ./telegram_bot/backend/

# 3. Python moduli to'g'ri import bo'lishi uchun muhit yo'lini ko'rsatamiz
ENV PYTHONPATH=/app/telegram_bot/backend
WORKDIR /app/telegram_bot/backend

EXPOSE 8000

# 4. FastAPI dasturini ishga tushiramiz (Endi u app.main-ni aniq topadi)
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
