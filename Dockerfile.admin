FROM node:18-alpine

# 1. Konteyner ichida ishchi papka ochamiz
WORKDIR /app

# 2. Rootdan turib, admin papkasidagi package fayllarini konteynerning admin papkasiga nusxalaymiz
COPY admin/package*.json ./admin/

# 3. Konteyner ichidagi admin papkasiga kirib, modullarni o'rnatamiz
WORKDIR /app/admin
RUN npm install

# 4. Yana orqaga qaytib, rootdagi butun admin kodlarini konteyner ichiga ko'chiramiz
WORKDIR /app
COPY admin/ ./admin/

# 5. Admin papkasiga kiramiz (shunda barcha Tailwind va konfiguratsiyalar o'z joyida bo'ladi)
WORKDIR /app/admin

# 6. Next.js loyihasini build qilamiz
RUN npm run build

EXPOSE 3000

# 7. Loyihani ishga tushirish buyrug'i
CMD ["npm", "start"]
